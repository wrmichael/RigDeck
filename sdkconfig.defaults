CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_LWIP_MAX_SOCKETS=16

# The IC-7100's USB port is a hub with two serial chips and an audio codec behind it.
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=n
# The radio's audio codec has a configuration descriptor of 1191 bytes; the default limit is 256.
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096

# The FT8 decoder keeps two ~240 kB slot buffers: PSRAM is required.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Only allocations of 512 bytes or less come from internal RAM first; bigger ones go to PSRAM.
# (4096 let web-page JSON, network buffers and drawing take 30 kB of internal RAM in a burst; with no
# internal DMA memory left, even the SHA engine failed and Wi-Fi updates were rejected.)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
