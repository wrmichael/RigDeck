# ESP32-P4 boards reach Wi-Fi through the on-board ESP32-C6 (esp_hosted over SDIO). The pin defaults
# of the esp_hosted component match Espressif's ESP32-P4-Function-EV-Board; other boards may need
# "idf.py menuconfig" -> Component config -> ESP-Hosted config.
CONFIG_SPIRAM=y
# Wi-Fi chip firmware 3.x sends software-aggregated SDIO transfers with ~16 kB buffers. Keep those
# DMA buffers in PSRAM: in internal RAM they leave too little for the network and the USB radio.
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
# USB host DMA descriptor lists and transfer buffers (UAC audio, CDC) in PSRAM too: in internal RAM
# they competed with everything else, and a failed allocation lost CAT or TX audio.
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

# On-device touch interface: LVGL 9 on the Waveshare 7 inch display (settings as in Waveshare's examples).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y

# microSD card for the log: long file names ("AC9HP_archive.adi"). stdio buffers stay small
# (FSTAT_BLKSIZE 0): they come from internal RAM, which the USB host and Wi-Fi need.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Waveshare ESP32-P4-WIFI6-Touch-LCD-7B: 32 MB flash. Room for the two update slots (partitions_p4.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_p4.csv"
# A firmware update from the web page that fails to start goes back to the previous one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Allocation hook for the internal-RAM low-point tracer (main/memtrace.c).
CONFIG_HEAP_USE_HOOKS=y
